{
  "name": "medlink-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev:web": "pnpm --filter @medlink/web dev",
    "dev:api": "pnpm --filter @medlink/api start:dev",
    "dev": "pnpm --parallel dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "db:generate": "pnpm --filter @medlink/api prisma:generate",
    "db:migrate": "pnpm --filter @medlink/api prisma:migrate",
    "db:deploy": "pnpm --filter @medlink/api prisma:deploy",
    "db:seed": "pnpm --filter @medlink/api prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.7.3"
  }
}
