# -----------------------------------------------------------------------------
# MedLink Web (apps/web) Environment Configuration
# Copy this file to .env inside apps/web/
# -----------------------------------------------------------------------------

# API Base URL (points to local NestJS backend)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# WebSocket URL for real-time features (chat, notifications)
VITE_WS_URL=http://localhost:4000

# Application Branding
VITE_APP_TITLE=MedLink
